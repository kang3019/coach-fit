# AI API 설정 (설정하지 않으면 지능형 더미 코칭 모드로 자동 동작합니다)
# Groq — console.groq.com 에서 무료 발급 (카드 등록 불필요, 분당 30회, 추천)
GROQ_API_KEY=your_groq_api_key_here
# Gemini — Google AI Studio (aistudio.google.com, 결제 설정 필요)
GEMINI_API_KEY=your_gemini_api_key_here
# OpenAI gpt-4o-mini — 유료
OPENAI_API_KEY=your_openai_api_key_here
# Claude Sonnet 5.5 — console.anthropic.com ($5 신규 크레딧)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# AWS Bedrock (교수님 권고 — EC2 배포 시 IAM Role 자동 인증 지원)
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_access_key_here
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
# 추천 Bedrock 모델:
# - anthropic.claude-3-5-sonnet-20240620-v1:0 (최고 성능 코칭)
# - anthropic.claude-3-haiku-20240307-v1:0 (경량/고속)
# - amazon.nova-lite-v1:0 (Amazon 초경량 모델)

AI_PROVIDER=dummy # dummy | bedrock | groq | gemini | claude | openai

# 서버 설정
HOST=0.0.0.0
PORT=8000

# 데이터베이스 설정 (기본값: 로컬 SQLite coachfit.db 자동 사용)
# AWS RDS (PostgreSQL, 교수님 권고) 사용 시 아래 주석 해제 및 접속 정보 기입:
# DATABASE_URL=postgresql://coachfit_admin:your_password@your-rds-endpoint.rds.amazonaws.com:5432/coachfit

