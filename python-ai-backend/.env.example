# AI API 설정 (설정하지 않으면 지능형 더미 코칭 모드로 자동 동작합니다)
# Gemini 2.5 Flash — Google AI Studio 에서 무료 발급 (하루 1,500회 / 분당 15회 무료 티어)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_PROVIDER=dummy # dummy | gemini | claude | openai

# 서버 설정
HOST=0.0.0.0
PORT=8000

# 데이터베이스 설정 (기본값: 로컬 SQLite coachfit.db 자동 사용)
# PostgreSQL(교수님 권고) 사용 시 아래 주석 해제 및 접속 정보 기입:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/coachfit

