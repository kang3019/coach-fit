# AI API 설정 (설정하지 않으면 지능형 더미 코칭 모드로 자동 동작합니다)
# Groq — console.groq.com 에서 무료 발급 (카드 등록 불필요, 분당 30회, 추천)
GROQ_API_KEY=your_groq_api_key_here
# Gemini — Google AI Studio (aistudio.google.com, 결제 설정 필요)
GEMINI_API_KEY=your_gemini_api_key_here
# OpenAI gpt-4o-mini — 유료
OPENAI_API_KEY=your_openai_api_key_here
# Claude Sonnet 5.5 — console.anthropic.com ($5 신규 크레딧)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_PROVIDER=dummy # dummy | groq | gemini | claude | openai

# 서버 설정
HOST=0.0.0.0
PORT=8000

# 데이터베이스 설정 (기본값: 로컬 SQLite coachfit.db 자동 사용)
# PostgreSQL(교수님 권고) 사용 시 아래 주석 해제 및 접속 정보 기입:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/coachfit

